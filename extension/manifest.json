{
  "manifest_version": 3,
  "name": "Save Image As",
  "short_name": "Save Image As",
  "version": "1.0.1",
  "description": "Save any image as PNG, JPG, WebP, AVIF or PDF from the right-click menu. Real conversion, highest resolution, 100% local & private.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "116"
}
