{
  "name": "save-image-as-extension",
  "version": "1.2.0",
  "private": true,
  "description": "Save Image As — Chrome extension. Save any web image as PNG, JPG, WebP, AVIF or PDF from the right-click menu.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "zip": "node build.mjs --zip",
    "test": "vitest run && npm run check:telemetry && npm run check:contrast && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "check:telemetry": "node scripts/check-no-telemetry.mjs",
    "render:site": "node scripts/render-site-images.mjs",
    "e2e": "node build.mjs --e2e && playwright test -c e2e",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "render:sample": "node scripts/render-welcome-sample.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.23.0",
    "geist": "^1.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1"
  }
}
